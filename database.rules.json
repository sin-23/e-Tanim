{
  "rules": {
    ".read": false,
    ".write": false,
    "sensors": {
      ".read": true,
      ".write": false,
      "$zone": {
        ".read": true,
        ".write": false,
        ".validate": "newData.hasChildren(['moisture', 'temperature', 'humidity', 'updatedAt'])",
        "moisture": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "temperature": {
          ".validate": "newData.isNumber() && newData.val() >= -40 && newData.val() <= 85"
        },
        "humidity": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "plant": {
          ".validate": "newData.isString() && newData.val().length <= 32"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "averages": {
      ".read": true,
      ".write": false
    },
    "reservoirs": {
      ".read": true,
      ".write": false,
      "water": {
        ".validate": "newData.hasChildren(['level', 'low', 'updatedAt'])",
        "level": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "low": {
          ".validate": "newData.isBoolean()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "$other": {
          ".validate": false
        }
      },
      "fertilizer": {
        ".validate": "newData.hasChildren(['level', 'low', 'updatedAt'])",
        "level": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "low": {
          ".validate": "newData.isBoolean()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "$other": {
          ".validate": false
        }
      },
      "$other": {
        ".validate": false
      }
    },
    "detections": {
      ".read": true,
      ".write": false,
      "$crop": {
        ".validate": "($crop == 'tomato' || $crop == 'eggplant' || $crop == 'bell_pepper') && newData.hasChildren(['underripe', 'ripe', 'damaged', 'updatedAt'])",
        "underripe": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "ripe": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "damaged": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "confidence": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "fruits": {
          "$i": {
            ".validate": "newData.hasChildren(['id'])",
            "id": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "stage": {
              ".validate": "newData.isString() && (newData.val() == 'underripe' || newData.val() == 'ripe' || newData.val() == 'damaged')"
            },
            "confidence": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "notifications": {
      ".read": true,
      ".write": false,
      "$id": {
        ".validate": "newData.hasChildren(['type', 'message', 'createdAt'])",
        "type": {
          ".validate": "newData.val() == 'reservoir_low' || newData.val() == 'harvest_ready'"
        },
        "source": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "message": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "control": {
      ".read": true,
      "relay_lowland": {
        ".write": "auth != null"
      },
      "relay_lowland_off_at": {
        ".write": "auth != null"
      },
      "relay_highland": {
        ".write": "auth != null"
      },
      "relay_highland_off_at": {
        ".write": "auth != null"
      },
      "relay_fert": {
        ".write": "auth != null"
      },
      "relay_fert_off_at": {
        ".write": "auth != null"
      },
      "relay_mist": {
        ".write": "auth != null"
      },
      "relay_mist_off_at": {
        ".write": "auth != null"
      }
    },
    "config": {
      ".read": true,
      "thresholds": {
        ".write": "auth != null"
      },
      "thresholds_updated": {
        ".write": "auth != null"
      },
      "thresholds_pump2": {
        ".write": "auth != null"
      },
      "thresholds_pump2_updated": {
        ".write": "auth != null"
      },
      "thresholds_highland": {
        ".write": "auth != null"
      },
      "thresholds_highland_updated": {
        ".write": "auth != null"
      },
      "irrigation": {
        ".write": "auth != null"
      },
      "irrigation_updated": {
        ".write": "auth != null"
      },
      "irrigation_override_zone": {
        ".write": "auth != null"
      },
      "irrigation_override_zone_updated": {
        ".write": "auth != null"
      },
      "reservoir_low": {
        ".write": "auth != null",
        "water": {
          ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 95"
        },
        "fertilizer": {
          ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 95"
        },
        "$other": {
          ".validate": false
        }
      },
      "reservoir_low_updated": {
        ".write": "auth != null"
      },
      "misting": {
        ".write": "auth != null"
      },
      "misting_updated": {
        ".write": "auth != null"
      },
      "fert_schedule": {
        ".write": "auth != null"
      },
      "fert_schedule_updated": {
        ".write": "auth != null"
      },
      "fert_active_source": {
        ".write": "auth != null"
      },
      "fert_active_source_updated": {
        ".write": "auth != null"
      }
    },
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "$uid === auth.uid"
      }
    }
  }
}