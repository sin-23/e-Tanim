{
  "rules": {
    ".read":  false,
    ".write": false,

    "sensors": {
      ".read": true,
      ".write": false,

      "$zone": {
        ".read": true,
        ".write": false,

        ".validate": "newData.hasChildren(['moisture', 'temperature', 'humidity', 'updatedAt'])",

        "moisture": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "temperature": {
          ".validate": "newData.isNumber() && newData.val() >= -40 && newData.val() <= 85"
        },
        "humidity": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "plant": {
          ".validate": "newData.isString() && newData.val().length <= 32"
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "averages": {
      ".read": true,
      ".write": false
    },

    "control": {
      ".read": true,
      "relay": {
        ".write": true
      },
      "relay_off_at": {
        ".write": true
      },
      "relay2": {
        ".write": true
      },
      "relay2_off_at": {
        ".write": true
      },
      "relay3": {
        ".write": true
      },
      "relay3_off_at": {
        ".write": true
      }
    },

    "config": {
      ".read": true,
      "thresholds": {
        ".write": true
      },
      "thresholds_updated": {
        ".write": true
      },
      "thresholds_pump2": {
        ".write": true
      },
      "thresholds_pump2_updated": {
        ".write": true
      },
      "irrigation": {
        ".write": true
      },
      "irrigation_updated": {
        ".write": true
      },
      "irrigation_override_zone": {
        ".write": true
      },
      "irrigation_override_zone_updated": {
        ".write": true
      },
      "fert_schedule": {
        ".write": true
      },
      "fert_schedule_updated": {
        ".write": true
      },
      "fert_active_source": {
        ".write": true
      },
      "fert_active_source_updated": {
        ".write": true
      }
    }
  }
}