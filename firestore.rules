rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Activity log of one unit. Signed-in read and create; no update or delete.
    // Firestore rules cannot read the Realtime Database, so membership of the unit cannot be checked here (decision log item 50).
    match /systems/{systemId}/activity_log/{entryId} {
      allow read: if request.auth != null;
      allow update, delete: if false;
      allow create: if request.auth != null && isValidEntry(request.resource.data);
    }

    // Zone period averages (decision log items 10, 46, 47). Signed-in read; no update or delete.
    // Create is denied until the ESP32's sign-in to Firestore is decided (pending item 6).
    // Then replace `false` with a check for the device account. The Console and the Admin SDK bypass these rules.
    match /systems/{systemId}/zone_period_averages/{docId} {
      allow read: if request.auth != null;
      allow update, delete: if false;
      allow create: if false; // later: request.auth.uid == '<device uid>' && isValidAverage(request.resource.data)
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }

  function isValidEntry(data) {
    return data.keys().hasAll(['message', 'color', 'type', 'timestamp'])
      && data.keys().hasOnly(['message', 'color', 'type', 'timestamp', 'createdAt', 'by', 'category', 'manual'])
      && data.message is string
      && data.message.size() > 0
      && data.message.size() <= 300
      && data.color is string
      && data.color.matches('^#[0-9a-fA-F]{6}$')
      && data.type is string
      && data.type.size() <= 50
      && data.timestamp is number
      && data.timestamp > (request.time.toMillis() - 5 * 60 * 1000)
      && data.timestamp < (request.time.toMillis() + 5 * 60 * 1000)
      && (!('by' in data) || (data.by is string && data.by.size() <= 100))
      && (!('category' in data) || (data.category is string && data.category.size() <= 50))
      && (!('manual' in data) || data.manual is bool);
  }

  // Ready for when create is opened. Shape: decision log items 10 and 46, checklist 3.4 and 9.6.
  function isValidAverage(data) {
    return data.keys().hasAll(['zone', 'period', 'date', 'soilMoisture', 'temperature', 'humidity', 'vpd', 'minimum', 'maximum', 'sampleCount', 'createdAt'])
      && data.keys().hasOnly(['zone', 'period', 'date', 'soilMoisture', 'temperature', 'humidity', 'vpd', 'minimum', 'maximum', 'sampleCount', 'createdAt'])
      && data.zone in ['lowland', 'highland']
      && data.period in ['morning', 'afternoon', 'night']
      && data.date is string
      && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
      && data.soilMoisture is number && data.soilMoisture >= 0 && data.soilMoisture <= 100
      && data.temperature is number && data.temperature >= -40 && data.temperature <= 85
      && data.humidity is number && data.humidity >= 0 && data.humidity <= 100
      && data.vpd is number && data.vpd >= 0 && data.vpd <= 10
      && data.minimum is map && data.maximum is map
      && data.minimum.keys().hasOnly(['soilMoisture', 'temperature', 'humidity', 'vpd'])
      && data.maximum.keys().hasOnly(['soilMoisture', 'temperature', 'humidity', 'vpd'])
      && data.sampleCount is int && data.sampleCount >= 1 && data.sampleCount <= 100000
      && data.createdAt == request.time;
  }
}
