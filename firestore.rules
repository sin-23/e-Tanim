rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Activity log of one unit. Signed-in read and create; no update or delete.
    // Firestore rules cannot read the Realtime Database, so membership of the unit
    // cannot be checked here (decision log item 50).
    match /systems/{systemId}/activity_log/{entryId} {
      allow read: if request.auth != null;
      allow update, delete: if false;
      allow create: if request.auth != null && isValidEntry(request.resource.data);
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }

  function isValidEntry(data) {
    return data.keys().hasAll(['message', 'color', 'type', 'timestamp'])
      && data.keys().hasOnly(['message', 'color', 'type', 'timestamp', 'createdAt', 'by', 'category', 'manual'])
      && data.message is string
      && data.message.size() > 0
      && data.message.size() <= 300
      && data.color is string
      && data.color.matches('^#[0-9a-fA-F]{6}$')
      && data.type is string
      && data.type.size() <= 50
      && data.timestamp is number
      && data.timestamp > (request.time.toMillis() - 5 * 60 * 1000)
      && data.timestamp < (request.time.toMillis() + 5 * 60 * 1000)
      && (!('by' in data) || (data.by is string && data.by.size() <= 100))
      && (!('category' in data) || (data.category is string && data.category.size() <= 50))
      && (!('manual' in data) || data.manual is bool);
  }
}
